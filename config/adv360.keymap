#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        mtb: mtb {
            compatible = "zmk,behavior-hold-tap";
            label = "Mod Tab Balanced";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            retro-tap;
        };

        hm_l: hm_l {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home-row mod L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            // Right-hand keys, then thumb keys, then = and the left/right arrows (0 63 64),
            // which count for the left-hand mods too, as in kanata. See assets/key-positions.md.
            hold-trigger-key-positions = <
                7 8 9 10 11 12 13 21 22 23 24 25 26 27 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75
                35 36 52 65 66 67 37 38 53 68 69 70
                0 63 64
            >;
            hold-trigger-on-release;
        };

        hm_l_slow: hm_l_slow {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home-row mod L slow";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <500>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <250>;
            hold-trigger-key-positions = <
                7 8 9 10 11 12 13 21 22 23 24 25 26 27 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75
                35 36 52 65 66 67 37 38 53 68 69 70
                0 63 64
            >;
            hold-trigger-on-release;
            retro-tap;
        };

        hm_r: hm_r {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home-row mod R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            // Left-hand keys, then thumb keys. See assets/key-positions.md.
            hold-trigger-key-positions = <
                0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 46 47 48 49 50 51 60 61 62 63 64
                35 36 52 65 66 67 37 38 53 68 69 70
            >;
            hold-trigger-on-release;
        };

        hm_r_slow: hm_r_slow {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home-row mod R slow";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <500>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <250>;
            hold-trigger-key-positions = <
                0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 46 47 48 49 50 51 60 61 62 63 64
                35 36 52 65 66 67 37 38 53 68 69 70
            >;
            hold-trigger-on-release;
            retro-tap;
        };

        vim_bspc: vim_bspc {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Backspace / Vim";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            retro-tap;
        };

        vim_space: vim_space {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Space / Vim";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            retro-tap;
        };

        shift_sel_l: shift_sel_l {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Shift / select left";
            bindings = <&kp>, <&sel_l_taps>;

            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
        };

        shift_sel_r: shift_sel_r {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Shift / select right";
            bindings = <&kp>, <&sel_r_taps>;

            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
        };

        // shift_sel_* hand a tap over only when Shift is let go, but the tap-dance
        // window is timed from the press: 300 ms leaves about 200 ms between presses.
        sel_l_taps: sel_l_taps {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Select left taps";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&kp LA(LS(LEFT))>, <&kp LG(LS(LEFT))>, <&kp LG(LS(UP))>;
        };

        sel_r_taps: sel_r_taps {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Select right taps";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&kp LA(LS(RIGHT))>, <&kp LG(LS(RIGHT))>, <&kp LG(LS(DOWN))>;
        };

        mods_toggle: mods_toggle {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home-row mods off/on";
            bindings = <&tog>, <&none>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <350>;
        };

        quit_app: quit_app {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Hold to quit app";
            bindings = <&Mac_Close_Program>, <&none>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <350>;
        };

        clear_bt: clear_bt {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Hold to clear BT profile";
            bindings = <&BT_Clear>, <&none>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <1000>;
        };

        // Taps its key or shortcut once, however long the key is held, like kanata's once
        // template. A held shortcut would repeat: a panel would open and close again.
        // It takes a parameter, so it sits here rather than in macros.dtsi, next to the
        // other behaviors with parameters.
        once: once {
            compatible = "zmk,behavior-macro-one-param";
            display-name = "Tap once";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1>, <&kp MACRO_PLACEHOLDER>;
        };

        hold_once: hold_once {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Hold to tap once";
            bindings = <&once>, <&none>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <350>;
        };

        sleep_pc: sleep_pc {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Hold to sleep (Windows)";
            bindings = <&Win_Sleep>, <&none>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <350>;
        };

        // macOS ignores quick presses of the power key. Ctrl+Cmd+power restarts the Mac
        // without saving, so with Ctrl or Cmd held the key does nothing.
        power_key: power_key {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Power (not with Ctrl or Cmd)";
            #binding-cells = <0>;
            bindings = <&kp C_POWER>, <&none>;

            mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>;
        };
    };

    // Win and ModsOff sit below keypad, fn and mod, so those layers work the same on Mac and Windows.
    // The exception is fn's system keys: on Windows, FnWin replaces the Mac shortcuts.
    keymap {
        compatible = "zmk,keymap";

        Mac {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 3                                                                                                                                               &mo 5      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &tog 1                                                                                                                                               &none      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &hm_l_slow LCTRL A  &hm_l_slow LALT S  &hm_l LGUI D  &hm_l LSHFT F  &kp G  &none  &kp LGUI        &kp LALT                         &kp RALT                        &kp RGUI                            &none      &kp H   &hm_r RSHFT J  &hm_r RGUI K  &hm_r_slow RALT L  &hm_r_slow RCTRL SEMI  &kp SQT
&shift_sel_l LSHFT 0  &kp Z  &kp X  &kp C  &kp V     &kp B                                                   &mt LCTRL HOME                   &mt RCTRL PG_UP                                                                &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &shift_sel_r RSHFT 0
&mo 4      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &vim_bspc 6 BACKSPACE  &mtb LA(LC(LG(LEFT_SHIFT))) DEL  &mtb LA(LC(LEFT_SHIFT)) END  &mtb RA(RC(RIGHT_SHIFT)) PG_DN  &mtb RA(RC(RG(RIGHT_SHIFT))) ENTER  &vim_space 6 SPACE  &kp UP  &kp DOWN  &kp LBKT  &kp RBKT  &mo 4
            >;
        };

        Win {
            display-name = "Win";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                             &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                             &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp A   &kp S   &kp D   &kp F   &trans  &trans  &kp LCTRL  &trans             &trans            &kp RCTRL  &trans  &trans  &kp J   &kp K   &kp L   &kp SEMI  &trans
&kp LSHFT  &trans  &trans  &trans  &trans  &trans                  &mt LGUI HOME      &mt RGUI PAGE_UP                     &trans  &trans  &trans  &trans  &trans  &kp RSHFT
&trans  &trans  &trans  &trans  &trans          &kp BACKSPACE  &kp DEL  &kp END       &kp PG_DN         &kp ENTER  &kp SPACE       &trans  &trans  &trans  &trans  &trans
            >;
        };

        ModsOff {
            display-name = "Mods off";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans    &trans
&trans  &kp A   &kp S   &kp D   &kp F   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp J   &kp K   &kp L   &kp SEMI  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans                  &trans  &trans  &trans  &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans    &trans
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 5      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &trans     &trans        &trans     &trans     &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 4      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 4
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2                  &kp F3                &kp F4  &kp F5            &kp F6             &tog 3                                                          &mo 5  &kp F7        &kp F8            &kp F9        &kp F10             &kp F11              &kp F12
&none   &hold_once LC(LG(Q)) 0  &none                 &none   &once LS(LG(N5))  &once LA(LG(ESC))  &none                                                           &none  &none         &once LA(LG(F5))  &none         &once LA(C_VOL_UP)  &once LA(C_BRI_INC)  &none
&trans  &none                   &once LC(LS(LG(N4)))  &none   &once LS(LG(N3))  &none              &none               &trans  &trans  &trans  &trans              &none  &once C_PREV  &kp C_VOL_DN      &kp C_VOL_UP  &once C_NEXT        &once C_MUTE         &once LG(LS(M))
&trans  &power_key              &none                 &none   &Mac_Clipboard    &none                                          &trans  &trans                             &none         &mods_toggle 2 0  &none         &none               &none                &trans
&trans  &none                   &none                 &none   &none                                        &once C_PP  &trans  &trans  &trans  &trans  &once C_PP                       &none             &none         &none               &none                &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&out OUT_TOG    &Mac_BT       &Win_BT       &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &clear_bt 0 0  &none    &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        Vim {
            display-name = "Vim";
            bindings = <
&none        &none          &none          &none       &kp LG(RIGHT)  &none         &none                                         &none  &none      &none             &none   &none      &kp LG(LEFT)  &none
&kp LG(TAB)  &quit_app 0 0  &kp LA(RIGHT)  &none       &kp LG(LS(Z))  &none         &none                                         &none  &kp LG(C)  &kp LG(Z)         &none   &none      &kp LG(V)     &none
&kp ESC      &none          &kp LALT       &kp LG(X)   &kp LSHFT      &none         &none         &none  &none  &none  &none      &none  &kp LEFT   &kp DOWN          &kp UP  &kp RIGHT  &none         &none
&kp LSHFT    &none          &kp DEL        &caps_word  &none          &kp LA(LEFT)                       &none  &none                    &none      &mods_toggle 2 0  &none   &none      &kp LG(F)     &kp RSHFT
&none        &none          &none          &none       &none                        &kp LA(BSPC)  &none  &none  &none  &kp ENTER  &none             &none             &none   &none      &none         &none
            >;
        };

        FnWin {
            display-name = "Fn Win";
            bindings = <
&trans  &trans              &trans           &trans       &trans           &trans             &trans                                                  &trans  &trans       &trans       &trans       &trans           &trans       &trans
&trans  &hold_once LG(L) 0  &trans           &trans       &once LG(LS(R))  &once LC(LS(ESC))  &trans                                                  &trans  &trans       &once LG(U)  &once LG(I)  &once LG(LC(V))  &once LG(P)  &trans
&trans  &once LG(A)         &once LG(LS(S))  &trans       &once LG(PSCRN)  &trans             &trans          &trans  &trans  &trans  &trans          &trans  &trans       &trans       &trans       &trans           &trans       &once LG(LA(K))
&trans  &sleep_pc 0 0       &once LG(X)      &once LG(K)  &once LG(V)      &trans                                     &trans  &trans                          &once LG(N)  &none        &trans       &trans           &trans       &trans
&trans  &trans              &trans           &trans       &trans                                      &trans  &trans  &trans  &trans  &trans  &trans                       &trans       &trans       &trans           &trans       &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        fn_on_win {
            if-layers = <1 4>;
            then-layer = <7>;
        };
    };
};
