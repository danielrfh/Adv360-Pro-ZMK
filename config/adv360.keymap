#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define KEYS_L 0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 46 47 48 49 50 51 60 61 62 63 64
#define KEYS_R 7 8 9 10 11 12 13 21 22 23 24 25 26 27 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75
#define THUMBS_LEFT 35 36 52 65 66 67
#define THUMBS_RIGHT 37 38 53 68 69 70

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        mtb: mtb {
            compatible = "zmk,behavior-hold-tap";
            label = "Mod Tab Balanced";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        hm_l: hm_l {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home-row mod L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            // = and the left/right arrows (0 63 64) count for the left-hand mods too, as in kanata.
            hold-trigger-key-positions = <KEYS_R THUMBS_LEFT THUMBS_RIGHT 0 63 64>;
            hold-trigger-on-release;
        };

        hm_l_slow: hm_l_slow {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home-row mod L slow";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <500>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <250>;
            hold-trigger-key-positions = <KEYS_R THUMBS_LEFT THUMBS_RIGHT 0 63 64>;
            hold-trigger-on-release;
            retro-tap;
        };

        hm_r: hm_r {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home-row mod R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMBS_LEFT THUMBS_RIGHT>;
            hold-trigger-on-release;
        };

        hm_r_slow: hm_r_slow {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home-row mod R slow";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <500>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <250>;
            hold-trigger-key-positions = <KEYS_L THUMBS_LEFT THUMBS_RIGHT>;
            hold-trigger-on-release;
            retro-tap;
        };

        vim_bspc: vim_bspc {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Backspace / Vim";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
        };

        vim_space: vim_space {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Space / Vim";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
        };

        shift_sel_l: shift_sel_l {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Shift / select left";
            bindings = <&kp>, <&sel_l_taps>;

            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
        };

        shift_sel_r: shift_sel_r {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Shift / select right";
            bindings = <&kp>, <&sel_r_taps>;

            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
        };

        // shift_sel_* hand a tap over only when Shift is let go, but the tap-dance
        // window is timed from the press: 300 ms leaves about 200 ms between presses.
        sel_l_taps: sel_l_taps {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Select left taps";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&kp LA(LS(LEFT))>, <&kp LG(LS(LEFT))>, <&kp LG(LS(UP))>;
        };

        sel_r_taps: sel_r_taps {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Select right taps";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&kp LA(LS(RIGHT))>, <&kp LG(LS(RIGHT))>, <&kp LG(LS(DOWN))>;
        };

        mods_toggle: mods_toggle {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home-row mods off/on";
            bindings = <&tog>, <&none>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <350>;
        };

        quit_app: quit_app {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Hold to quit app";
            bindings = <&Mac_Close_Program>, <&none>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <350>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Mac {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 1                                                                                                                                               &mo 3      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &tog 4                                                                                                                                               &none      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &hm_l_slow LCTRL A  &hm_l_slow LALT S  &hm_l LGUI D  &hm_l LSHFT F  &kp G  &none  &kp LGUI        &kp LALT                         &kp RALT                        &kp RGUI                            &none      &kp H   &hm_r RSHFT J  &hm_r RGUI K  &hm_r_slow RALT L  &hm_r_slow RCTRL SEMI  &kp SQT
&shift_sel_l LSHFT 0  &kp Z  &kp X  &kp C  &kp V     &kp B                                                   &mt LCTRL HOME                   &mt RCTRL PG_UP                                                                &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &shift_sel_r RSHFT 0
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &vim_bspc 6 BACKSPACE  &mtb LA(LC(LG(LEFT_SHIFT))) DEL  &mtb LA(LC(LEFT_SHIFT)) END  &mtb RA(RC(RIGHT_SHIFT)) PG_DN  &mtb RA(RC(RG(RIGHT_SHIFT))) ENTER  &vim_space 6 SPACE  &kp UP  &kp DOWN  &kp LBKT  &kp RBKT  &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 3      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;

            label = "White";
        };

        fn {
            display-name = "Blue";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;

            label = "Blue";
        };

        mod {
            display-name = "Mod";
            bindings = <
&out OUT_TOG    &Mac_BT       &Win_BT       &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;

            label = "Green";
        };

        Win {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                             &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                             &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp A   &kp S   &kp D   &kp F   &trans  &trans  &kp LCTRL  &trans             &trans            &kp RCTRL  &trans  &trans  &kp J   &kp K   &kp L   &kp SEMI  &trans
&kp LSHFT  &trans  &trans  &trans  &trans  &trans                  &mt LGUI HOME      &mt RGUI PAGE_UP                     &trans  &trans  &trans  &trans  &trans  &kp RSHFT
&trans  &trans  &trans  &trans  &trans          &kp BACKSPACE  &kp DEL  &kp END       &kp PG_DN         &kp ENTER  &kp SPACE       &trans  &trans  &trans  &trans  &trans
            >;

            label = "Red";
        };

        ModsOff {
            display-name = "Mods off";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans    &trans
&trans  &kp A   &kp S   &kp D   &kp F   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp J   &kp K   &kp L   &kp SEMI  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans                  &trans  &trans  &trans  &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans    &trans
            >;
        };

        Vim {
            display-name = "Vim";
            bindings = <
&none        &none          &none          &none       &kp LG(RIGHT)  &none         &none                                         &none  &none      &none             &none   &none      &kp LG(LEFT)  &none
&kp LG(TAB)  &quit_app 0 0  &kp LA(RIGHT)  &none       &kp LG(LS(Z))  &none         &none                                         &none  &kp LG(C)  &kp LG(Z)         &none   &none      &kp LG(V)     &none
&kp ESC      &none          &kp LALT       &kp LG(X)   &kp LSHFT      &none         &none         &none  &none  &none  &none      &none  &kp LEFT   &kp DOWN          &kp UP  &kp RIGHT  &none         &none
&kp LSHFT    &none          &kp DEL        &caps_word  &none          &kp LA(LEFT)                       &none  &none                    &none      &mods_toggle 5 0  &none   &none      &kp LG(F)     &kp RSHFT
&none        &none          &none          &none       &none                        &kp LA(BSPC)  &none  &none  &none  &kp ENTER  &none             &none             &none   &none      &none         &none
            >;
        };

        KeypadFix {
            display-name = "Kp fix";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                  &trans     &trans  &trans     &trans     &trans     &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                  &trans     &trans  &trans     &trans     &trans     &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &kp HOME  &kp PG_UP                &trans  &trans     &trans     &trans     &trans       &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &kp KP_N0          &trans     &trans     &trans     &trans       &trans
            >;
        };

        ModFix {
            display-name = "Mod fix";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                  &trans           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                  &trans           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &none   &none   &none   &none   &trans  &trans  &none   &trans  &trans  &none   &trans           &trans  &none   &none   &none   &none   &trans
&none   &trans  &trans  &trans  &trans  &trans                  &none   &none                            &trans  &trans  &trans  &trans  &trans  &none
&trans  &trans  &trans  &trans  &trans          &none   &none   &none   &none   &bl BL_TOG  &rgb_ug RGB_TOG      &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    // Win and ModsOff sit above keypad and mod, so any key they don't leave &trans
    // would hide the keypad or mod key at the same position. KeypadFix and ModFix put
    // those keys back.
    conditional_layers {
        compatible = "zmk,conditional-layers";

        keypad_on_win {
            if-layers = <1 4>;
            then-layer = <7>;
        };

        keypad_mods_off {
            if-layers = <1 5>;
            then-layer = <7>;
        };

        mod_on_win {
            if-layers = <3 4>;
            then-layer = <8>;
        };

        mod_mods_off {
            if-layers = <3 5>;
            then-layer = <8>;
        };
    };
};
